<% content_for :title, "New Service" %>

<div class="mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header Section -->
  <div class="sm:flex sm:items-center sm:justify-between">
    <div class="sm:flex-auto">
      <h1 class="text-3xl font-bold text-gray-900">New Service</h1>
      <p class="mt-2 text-sm text-gray-700">Create a new website service for your application.</p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
      <%= link_to "Back to Services", manage_services_path,
                  class: "inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    </div>
  </div>

  <!-- Form Section -->
  <div class="mt-8">
    <%= render 'form' %>
  </div>
</div>