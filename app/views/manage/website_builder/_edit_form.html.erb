<!-- app/views/manage/website_builder/_edit_form.html.erb -->

<div id="component-edit-form-container" class="h-full flex flex-col">
  <div class="border-b border-gray-200 p-4">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">Edit Component</h3>
      <button type="button" class="text-gray-400 hover:text-gray-600" onclick="closeEditForm()">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto p-4">
    <%= form_with url: manage_update_component_customization_path(@page_slug, @theme_page.id, @component.id),
                  method: :patch,
                  remote: true,
                  id: "component-edit-form",
                  class: "space-y-4" do |form| %>

      <% @editable_fields.each do |field_name, field_type| %>
        <div class="form-group">
          <label for="customization_<%= field_name %>" class="block text-sm font-medium text-gray-700 mb-2">
            <%= field_name.humanize %>
          </label>

          <%# Use the pre-calculated form value (either custom or default) %>
          <% field_value = @form_values[field_name] || "" %>
          <% form_field_type = @field_types[field_name] %>

          <% if form_field_type == "textarea" %>
            <%= text_area_tag "customization[#{field_name}]",
                              field_value,
                              id: "customization_#{field_name}",
                              class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                              rows: 4,
                              placeholder: "Enter #{field_name.humanize.downcase}..." %>
            <% else %>
            <%= text_field_tag "customization[#{field_name}]",
                               field_value,
                               id: "customization_#{field_name}",
                               class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                               placeholder: "Enter #{field_name.humanize.downcase}..." %>
          <% end %>

          <%# Show a small hint about the default value if this is a customization %>
          <% if @form_values[field_name] == @editable_fields[field_name] %>
            <p class="mt-1 text-xs text-gray-500">Default template value</p>
          <% else %>
            <p class="mt-1 text-xs text-blue-600">Custom value</p>
          <% end %>
        </div>
      <% end %>

      <div class="flex gap-3 pt-4 border-t border-gray-200">
        <button type="button"
                class="flex-1 px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
                onclick="closeEditForm()">
          Cancel
        </button>
        <input type="submit"
               value="Update Component"
               class="flex-1 px-4 py-2 text-sm font-medium text-white bg-indigo-600 border border-transparent rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer">
      </div>
    <% end %>
  </div>
</div>