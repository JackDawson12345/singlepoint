    </nav>
  </aside>

  <!-- Updated Main Section -->
  <main class="flex-1 overflow-auto">
    <div class="flex">
      <div class="form-backdrop" id="form-backdrop" onclick="closeEditForm()"></div>

      <div style="width: 300px; height: calc(100vh - 4rem);" class="form-popup hidden" id="form-popup">
        <!-- Initially empty or with a placeholder -->
      </div>

      <!-- Viewport Container with centered preview -->
      <div class="flex-1 flex justify-center items-start bg-gray-100">
        <div id="viewport-container" class="viewport-desktop transition-all duration-300 bg-white shadow-lg">
          <div class="components-container h-full overflow-auto">
            <%= render 'manage/website_builder/components' %>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
    function switchViewport(type) {
        const container = document.getElementById('viewport-container');
        const toggles = document.querySelectorAll('.desktop-edit-toggle, .tablet-edit-toggle, .mobile-edit-toggle');
        const componentsContainer = container.querySelector('.components-container');

        // Remove active class from all toggles
        toggles.forEach(toggle => {
            toggle.classList.remove('active');
            toggle.style.background = 'rgb(229, 231, 235)';
            const svg = toggle.querySelector('svg');
            if (svg) svg.style.stroke = '#000000';
        });

        // Remove all viewport classes
        container.classList.remove('viewport-desktop', 'viewport-tablet', 'viewport-mobile');
        componentsContainer.classList.remove('simulate-mobile', 'simulate-tablet', 'simulate-desktop');

        // Add appropriate class and activate toggle
        if (type === 'desktop') {
            container.classList.add('viewport-desktop');
            componentsContainer.classList.add('simulate-desktop');
            const toggle = document.querySelector('.desktop-edit-toggle');
            toggle.classList.add('active');
            toggle.style.background = 'rgb(59, 130, 246)';
            const svg = toggle.querySelector('svg');
            if (svg) svg.style.stroke = 'white';
        } else if (type === 'tablet') {
            container.classList.add('viewport-tablet');
            componentsContainer.classList.add('simulate-tablet');
            const toggle = document.querySelector('.tablet-edit-toggle');
            toggle.classList.add('active');
            toggle.style.background = 'rgb(59, 130, 246)';
            const svg = toggle.querySelector('svg');
            if (svg) svg.style.stroke = 'white';
        } else if (type === 'mobile') {
            container.classList.add('viewport-mobile');
            componentsContainer.classList.add('simulate-mobile');
            const toggle = document.querySelector('.mobile-edit-toggle');
            toggle.classList.add('active');
            toggle.style.background = 'rgb(59, 130, 246)';
            const svg = toggle.querySelector('svg');
            if (svg) svg.style.stroke = 'white';
        }
    }

    // Initialize with desktop view
    document.addEventListener('DOMContentLoaded', function() {
        switchViewport('desktop');

        // Add mobile menu toggle functionality for preview
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');

        if (mobileMenuButton && mobileMenu) {
            mobileMenuButton.addEventListener('click', function() {
                mobileMenu.classList.toggle('hidden');
            });
        }
    });
</script>

</body>

</html>
