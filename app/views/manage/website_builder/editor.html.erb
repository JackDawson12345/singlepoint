<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Single Point App" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
  <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <%# Includes all stylesheet files in app/assets/stylesheets %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <!-- At the bottom of your manage/website_builder/editor.html.erb -->
  <%= javascript_include_tag 'component_edit', 'data-turbo-track': 'reload' %>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.js"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
</head>

<body class=" text-gray-900">

<style>
    .component-section button {
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease-in-out, visibility 0.2s ease-in-out;
    }

    /* Show the button when hovering over the component section */
    .component-section:hover button {
        opacity: 1;
        visibility: visible;
    }

    .component-section {
        transition: outline 0s ease-in-out;
    }

    .component-section:hover {
        outline: 1px solid #7c3aed;
        outline-offset: -1px;
    }
    .form-popup.active {
        display: block !important;
    }

    /* Viewport Styles */
    .viewport-desktop {
        width: 100%;
        max-width: none;
        height: calc(100vh - 4rem);
        border-radius: 0;
    }

    .viewport-tablet {
        width: 1000px;
        max-width: 1000px;
        height: calc(100vh - 4rem);
        border-radius: 8px;
        border: 1px solid #e5e7eb;
    }

    .viewport-mobile {
        width: 375px;
        max-width: 375px;
        height: calc(100vh - 4rem);
        border-radius: 12px;
        border: 1px solid #e5e7eb;
    }

    /* Active toggle state */
    .desktop-edit-toggle.active,
    .tablet-edit-toggle.active,
    .mobile-edit-toggle.active {
        background: rgb(59, 130, 246) !important;
    }

    .desktop-edit-toggle.active svg,
    .tablet-edit-toggle.active svg,
    .mobile-edit-toggle.active svg {
        stroke: white;
    }

    /* Hover states */
    .desktop-edit-toggle:hover,
    .tablet-edit-toggle:hover,
    .mobile-edit-toggle:hover {
        background: rgb(209, 213, 219) !important;
    }

    .desktop-edit-toggle.active:hover,
    .tablet-edit-toggle.active:hover,
    .mobile-edit-toggle.active:hover {
        background: rgb(37, 99, 235) !important;
    }

    /* Mobile Simulation - Override Tailwind responsive classes */
    .simulate-mobile .md\:flex-row { flex-direction: column !important; }
    .simulate-mobile .md\:grid-cols-2 { grid-template-columns: repeat(1, minmax(0, 1fr)) !important; }
    .simulate-mobile .md\:grid-cols-3 { grid-template-columns: repeat(1, minmax(0, 1fr)) !important; }
    .simulate-mobile .md\:grid-cols-4 { grid-template-columns: repeat(1, minmax(0, 1fr)) !important; }
    .simulate-mobile .lg\:flex-row { flex-direction: column !important; }
    .simulate-mobile .lg\:grid-cols-2 { grid-template-columns: repeat(1, minmax(0, 1fr)) !important; }
    .simulate-mobile .lg\:grid-cols-3 { grid-template-columns: repeat(1, minmax(0, 1fr)) !important; }
    .simulate-mobile .lg\:grid-cols-4 { grid-template-columns: repeat(1, minmax(0, 1fr)) !important; }
    .simulate-mobile .xl\:flex-row { flex-direction: column !important; }
    .simulate-mobile .xl\:grid-cols-2 { grid-template-columns: repeat(1, minmax(0, 1fr)) !important; }
    .simulate-mobile .xl\:grid-cols-3 { grid-template-columns: repeat(1, minmax(0, 1fr)) !important; }
    .simulate-mobile .xl\:grid-cols-4 { grid-template-columns: repeat(1, minmax(0, 1fr)) !important; }

    /* Mobile padding and margin overrides */
    .simulate-mobile .md\:px-8 { padding-left: 1rem !important; padding-right: 1rem !important; }
    .simulate-mobile .md\:py-8 { padding-top: 2rem !important; padding-bottom: 2rem !important; }
    .simulate-mobile .lg\:px-8 { padding-left: 1rem !important; padding-right: 1rem !important; }
    .simulate-mobile .lg\:py-8 { padding-top: 2rem !important; padding-bottom: 2rem !important; }
    .simulate-mobile .md\:px-6 { padding-left: 1rem !important; padding-right: 1rem !important; }
    .simulate-mobile .lg\:px-6 { padding-left: 1rem !important; padding-right: 1rem !important; }

    /* Mobile text sizes */
    .simulate-mobile .md\:text-4xl { font-size: 2.25rem !important; line-height: 2.5rem !important; }
    .simulate-mobile .md\:text-5xl { font-size: 2.25rem !important; line-height: 2.5rem !important; }
    .simulate-mobile .lg\:text-4xl { font-size: 2.25rem !important; line-height: 2.5rem !important; }
    .simulate-mobile .lg\:text-5xl { font-size: 2.25rem !important; line-height: 2.5rem !important; }

    /* Mobile hide/show classes - more specific targeting */
    .simulate-mobile .md\:block { display: none !important; }
    .simulate-mobile .lg\:block { display: none !important; }
    .simulate-mobile .xl\:block { display: none !important; }

    /* Show mobile menu button in mobile view */
    .simulate-mobile .md\:hidden { display: block !important; }
    .simulate-mobile .lg\:hidden { display: block !important; }

    /* Mobile menu handling - should be hidden by default even in mobile view */
    .simulate-mobile #mobile-menu.hidden { display: none !important; }
    .simulate-mobile #mobile-menu.md\:hidden.hidden { display: none !important; }

    /* When mobile menu is shown (remove hidden class with JS) */
    .simulate-mobile #mobile-menu { display: block !important; }

    /* Small breakpoint overrides for mobile */
    .simulate-mobile .sm\:px-6 { padding-left: 1rem !important; padding-right: 1rem !important; }
    .simulate-mobile .sm\:px-3 { padding-left: 0.75rem !important; padding-right: 0.75rem !important; }

    /* Additional mobile responsive overrides */
    .simulate-mobile .sm\:grid-cols-2 { grid-template-columns: repeat(1, minmax(0, 1fr)) !important; }
    .simulate-mobile .sm\:grid-cols-3 { grid-template-columns: repeat(1, minmax(0, 1fr)) !important; }
    .simulate-mobile .sm\:flex-row { flex-direction: column !important; }
    .simulate-mobile .sm\:text-lg { font-size: 1rem !important; line-height: 1.5rem !important; }
    .simulate-mobile .sm\:text-xl { font-size: 1.125rem !important; line-height: 1.75rem !important; }

    /* Tablet Simulation */
    .simulate-tablet .lg\:grid-cols-4 { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    .simulate-tablet .lg\:grid-cols-3 { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    .simulate-tablet .xl\:grid-cols-4 { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    .simulate-tablet .xl\:grid-cols-3 { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }

    /* Container width overrides */
    .simulate-mobile .container,
    .simulate-mobile .max-w-7xl,
    .simulate-mobile .max-w-6xl,
    .simulate-mobile .max-w-5xl,
    .simulate-mobile .max-w-4xl,
    .simulate-mobile .max-w-3xl,
    .simulate-mobile .max-w-2xl,
    .simulate-mobile .max-w-xl {
        max-width: 100% !important;
        margin-left: auto !important;
        margin-right: auto !important;
        padding-left: 1rem !important;
        padding-right: 1rem !important;
    }

    .simulate-tablet .container,
    .simulate-tablet .max-w-7xl,
    .simulate-tablet .max-w-6xl {
        max-width: 768px !important;
        margin-left: auto !important;
        margin-right: auto !important;
        padding-left: 2rem !important;
        padding-right: 2rem !important;
    }

</style>

<!-- Top Bar -->
<header class="w-full bg-white h-16 flex items-center justify-between border-b">
  <div class="flex items-center w-full h-full">
    <div class="w-1/3 h-full">
      <div class="flex items-center justify-center border-r h-full" style="width: 67px">
        <div class="flex items-center">
          <%= link_to manage_dashboard_path, class: 'flex-shrink-0 flex items-center' do %>
            <div class="w-8 h-8 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
              </svg>
            </div>
          <% end %>
        </div>
      </div>


    </div>
    <!-- Updated Toggle Buttons -->
    <div class="w-1/3 flex gap-4 justify-center">
      <div>
        <div class="p-1 desktop-edit-toggle cursor-pointer transition-colors duration-200 active"
             style="background: rgb(229, 231, 235)"
             onclick="switchViewport('desktop')">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="-0.625 -0.625 20 20" fill="none" stroke="#000000" stroke-linecap="round" stroke-linejoin="round" class="feather feather-monitor" id="Monitor--Streamline-Feather" height="20" width="20">
            <path d="M3.125 2.34375h12.5s1.5625 0 1.5625 1.5625v7.8125s0 1.5625 -1.5625 1.5625H3.125s-1.5625 0 -1.5625 -1.5625V3.90625s0 -1.5625 1.5625 -1.5625" stroke-width="1.25"></path>
            <path d="m6.25 16.40625 6.25 0" stroke-width="1.25"></path>
            <path d="m9.375 13.28125 0 3.125" stroke-width="1.25"></path>
          </svg>
        </div>
      </div>
      <div class="p-1 tablet-edit-toggle cursor-pointer transition-colors duration-200"
           onclick="switchViewport('tablet')">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="-0.625 -0.625 20 20" fill="none" stroke="#000000" stroke-linecap="round" stroke-linejoin="round" class="feather feather-tablet" id="Tablet--Streamline-Feather" height="20" width="20">
          <path d="M4.6875 1.5625h9.375s1.5625 0 1.5625 1.5625v12.5s0 1.5625 -1.5625 1.5625H4.6875s-1.5625 0 -1.5625 -1.5625V3.125s0 -1.5625 1.5625 -1.5625" stroke-width="1.25"></path>
          <path d="m9.375 14.0625 0.0078125 0" stroke-width="1.25"></path>
        </svg>
      </div>
      <div class="p-1 mobile-edit-toggle cursor-pointer transition-colors duration-200"
           onclick="switchViewport('mobile')">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="-0.625 -0.625 20 20" fill="none" stroke="#000000" stroke-linecap="round" stroke-linejoin="round" class="feather feather-smartphone" id="Smartphone--Streamline-Feather" height="20" width="20">
          <path d="M5.46875 1.5625h7.8125s1.5625 0 1.5625 1.5625v12.5s0 1.5625 -1.5625 1.5625H5.46875s-1.5625 0 -1.5625 -1.5625V3.125s0 -1.5625 1.5625 -1.5625" stroke-width="1.25"></path>
          <path d="m9.375 14.0625 0.0078125 0" stroke-width="1.25"></path>
        </svg>
      </div>
    </div>

    <div class="w-1/3 flex justify-end h-full">
      <%= link_to manage_website_preview_path(page_slug: 'home'), class: 'flex items-center justify-center px-16' do %>
        <p class="">Preview</p>
      <% end %>
      <div style="background: rgb(229, 231, 235)" class="flex items-center justify-center px-16">
        <p class="text-black">Save</p>
      </div>
    </div>

  </div>
</header>

