<!-- app/views/manage/account_setups/_step_domain.html.erb -->
<%= form_with model: @account_setup,
              url: manage_account_setup_update_step_path(step: @current_step),
              method: :patch,
              local: true,
              data: { turbo: false },
              class: "space-y-6" do |form| %>

  <div class="text-center mb-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Choose Your Domain</h2>
    <p class="text-gray-600">Enter the domain name for your new website</p>
  </div>

  <div>
    <%= form.label :domain_name, "Domain Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <div class="relative">
      <%= form.text_field :domain_name,
                          placeholder: "example.com",
                          class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 #{'border-red-300' if @account_setup.errors[:domain_name].any?}" %>
    </div>
    <% if @account_setup.errors[:domain_name].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @account_setup.errors[:domain_name].first %></p>
    <% end %>
    <p class="mt-2 text-sm text-gray-500">Enter your domain without http:// or www.</p>
  </div>

  <div class="flex justify-between pt-4">
    <div></div>
    <%= form.submit "Continue", class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors" %>
  </div>
<% end %>