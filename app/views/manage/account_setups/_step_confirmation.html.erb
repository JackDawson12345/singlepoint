<!-- app/views/manage/account_setups/_step_confirmation.html.erb -->
<div class="text-center space-y-6">
  <% if @account_setup.completed? %>
    <div class="mx-auto w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
      <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>

    <h2 class="text-2xl font-bold text-gray-900">Setup Complete!</h2>
    <p class="text-gray-600 max-w-md mx-auto">
      Your account setup has been completed successfully. We'll begin working on your website and contact you within 1-2 business days with next steps.
    </p>

    <div class="bg-gray-50 rounded-lg p-6 max-w-md mx-auto">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Setup Details</h3>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-600">Domain:</span>
          <span class="font-medium"><%= @account_setup.domain_name %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Package:</span>
          <span class="font-medium"><%= @account_setup.package_type.humanize %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Support:</span>
          <div class="text-right">
            <span class="font-medium"><%= @account_setup.support_option.humanize %></span>
            <% if @account_setup.has_discount? %>
              <span class="ml-1 inline-block bg-green-100 text-green-800 text-xs font-semibold px-2 py-1 rounded-full">20% OFF</span>
            <% end %>
          </div>
        </div>

        <% if @account_setup.has_discount? %>
          <div class="flex justify-between text-green-600">
            <span class="text-gray-600">Discount:</span>
            <span class="font-medium">-£<%= format_price(@account_setup.discount_amount) %></span>
          </div>
        <% end %>

        <hr class="my-2">
        <div class="flex justify-between font-semibold">
          <span class="text-gray-600">Total Paid:</span>
          <span class="<%= @account_setup.has_discount? ? 'text-green-600' : 'text-gray-900' %>">
            £<%= format_price(@account_setup.final_price) %>
          </span>
        </div>
      </div>

      <% if @account_setup.has_discount? %>
        <div class="mt-4 p-3 bg-green-50 border border-green-200 rounded-lg">
          <p class="text-green-800 font-medium text-xs text-center">
            🎉 You saved £<%= format_price(@account_setup.discount_amount) %> with managed support!
          </p>
        </div>
      <% end %>
    </div>

    <%= link_to "Go to Dashboard", manage_dashboard_path,
                class: "inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors" %>
  <% else %>
    <div class="mx-auto w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mb-4">
      <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
      </svg>
    </div>

    <h2 class="text-2xl font-bold text-gray-900">Payment Pending</h2>
    <p class="text-gray-600">
      Your setup is not yet complete. Please complete the payment process.
    </p>

    <%= link_to "Complete Payment", manage_account_setup_step_path(step: 'payment'),
                class: "inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors" %>
  <% end %>
</div>