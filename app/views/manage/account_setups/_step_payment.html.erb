<!-- app/views/manage/account_setups/_step_payment.html.erb -->
<div class="space-y-6">
  <div class="text-center mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Payment</h2>
    <p class="text-gray-600">Complete your order</p>
  </div>

  <!-- Order Summary -->
  <div class="bg-gray-50 rounded-lg p-6 mb-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Order Summary</h3>
    <div class="space-y-3">
      <div class="flex justify-between">
        <span class="text-gray-600">Domain:</span>
        <span class="font-medium"><%= @account_setup.domain_name %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-600">Package:</span>
        <span class="font-medium"><%= @account_setup.package_type.humanize %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-600">Support:</span>
        <div class="text-right">
          <span class="font-medium"><%= @account_setup.support_option.humanize %></span>
          <% if @account_setup.has_discount? %>
            <span class="ml-2 inline-block bg-green-100 text-green-800 text-xs font-semibold px-2 py-1 rounded-full">20% OFF</span>
          <% end %>
        </div>
      </div>

      <hr class="my-3">

      <!-- Pricing breakdown -->
      <div class="space-y-2">
        <div class="flex justify-between">
          <span class="text-gray-600">Subtotal:</span>
          <span>£<%= format_price(@account_setup.base_price) %></span>
        </div>

        <% if @account_setup.has_discount? %>
          <div class="flex justify-between text-green-600">
            <span>Support Discount (20%):</span>
            <span>-£<%= format_price(@account_setup.discount_amount) %></span>
          </div>
        <% end %>

        <hr class="my-2">

        <div class="flex justify-between text-lg font-semibold">
          <span>Total:</span>
          <div class="text-right">
            <% if @account_setup.has_discount? %>
              <div class="text-sm text-gray-500 line-through">£<%= format_price(@account_setup.base_price) %></div>
            <% end %>
            <span class="<%= @account_setup.has_discount? ? 'text-green-600' : '' %>">
              £<%= format_price(@account_setup.final_price) %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Discount explanation -->
    <% if @account_setup.has_discount? %>
      <div class="mt-4 p-3 bg-green-50 border border-green-200 rounded-lg">
        <div class="flex items-start">
          <svg class="w-5 h-5 text-green-500 mt-0.5 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <div>
            <p class="text-green-800 font-medium text-sm">Managed Support Discount Applied!</p>
            <p class="text-green-700 text-sm">You're saving £<%= format_price(@account_setup.discount_amount) %> by choosing our managed support option.</p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Payment Form -->
  <div id="payment-form">
    <div id="payment-loading" class="text-center py-8">
      <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
      <p class="mt-2 text-gray-600">Loading payment form...</p>
    </div>

    <div id="payment-content" style="display: none;">
      <div id="payment-element">
        <!-- Stripe Elements will create form elements here -->
      </div>

      <div id="payment-messages" role="alert" class="text-red-600 text-sm mt-4" style="display: none;"></div>

      <div class="flex justify-between pt-6">
        <%= link_to "Back", manage_account_setup_step_path(step: @account_setup.previous_step),
                    class: "bg-gray-200 hover:bg-gray-300 text-gray-700 px-6 py-3 rounded-lg font-medium transition-colors" %>
        <button type="button" id="submit-payment" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors" disabled onclick="handlePaymentSubmit()">
          <span id="button-text">Pay £<%= format_price(@account_setup.final_price) %></span>
          <span id="spinner" style="display: none;">
            <div class="inline-block animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
          </span>
        </button>
      </div>
    </div>
  </div>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script>
    // Global variables
    let stripe;
    let elements;
    let paymentElement;



    async function initializeStripe() {


        try {
            // Initialize Stripe
            const publishableKey = '<%= Rails.application.credentials.stripe&.dig(:publishable_key) || ENV['STRIPE_PUBLISHABLE_KEY'] %>';

            if (!publishableKey) {
                throw new Error('Stripe publishable key is missing');
            }

            stripe = Stripe(publishableKey);

            // Create payment intent
            const response = await fetch('<%= manage_account_setup_create_payment_intent_path %>', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                }
            });


            if (!response.ok) {
                const errorText = await response.text();
                console.error('❌ Payment intent error:', errorText);
                throw new Error(`HTTP error! status: ${response.status} - ${errorText}`);
            }

            const data = await response.json();

            if (data.error) {
                throw new Error(data.error);
            }

            if (!data.client_secret) {
                throw new Error('No client_secret received from server');
            }

            // Create elements
            elements = stripe.elements({ clientSecret: data.client_secret });
            paymentElement = elements.create('payment');
            paymentElement.mount('#payment-element');


            // Show the payment form
            document.getElementById('payment-loading').style.display = 'none';
            document.getElementById('payment-content').style.display = 'block';
            document.getElementById('submit-payment').disabled = false;


        } catch (error) {
            console.error('💥 Stripe initialization failed:', error);
            document.getElementById('payment-loading').innerHTML = `
      <div class="text-center py-8">
        <div class="text-red-600 mb-4">
          <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <p class="text-red-600 font-medium">Failed to load payment form</p>
        <p class="text-gray-600 text-sm mt-1">${error.message}</p>
        <button onclick="location.reload()" class="mt-4 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded font-medium">
          Retry
        </button>
      </div>
    `;
        }
    }

    async function handlePaymentSubmit() {

        if (!stripe || !elements) {
            console.error('❌ Stripe not initialized');
            showMessage('Payment system not ready. Please refresh the page.');
            return;
        }

        setLoading(true);

        try {
            const { error } = await stripe.confirmPayment({
                elements,
                confirmParams: {
                    return_url: '<%= manage_account_setup_confirm_payment_url %>'
                }
            });

            if (error) {
                console.error('❌ Payment confirmation error:', error);
                if (error.type === "card_error" || error.type === "validation_error") {
                    showMessage(error.message);
                } else {
                    showMessage("An unexpected error occurred during payment.");
                }
            } else {
            }
        } catch (error) {
            console.error('💥 Payment submission failed:', error);
            showMessage("An unexpected error occurred.");
        }

        setLoading(false);
    }

    function showMessage(messageText) {
        const messageContainer = document.getElementById("payment-messages");
        messageContainer.style.display = 'block';
        messageContainer.textContent = messageText;

        setTimeout(function () {
            messageContainer.textContent = "";
            messageContainer.style.display = 'none';
        }, 5000);
    }

    function setLoading(isLoading) {
        const submitButton = document.getElementById("submit-payment");
        const buttonText = document.getElementById("button-text");
        const spinner = document.getElementById("spinner");

        if (isLoading) {
            submitButton.disabled = true;
            buttonText.style.display = 'none';
            spinner.style.display = 'inline-block';
        } else {
            submitButton.disabled = false;
            buttonText.style.display = 'inline-block';
            spinner.style.display = 'none';
        }
    }

    // Initialize when page loads
    document.addEventListener('DOMContentLoaded', function() {
        initializeStripe();
    });

    // Also handle if Turbo is being used
    document.addEventListener('turbo:load', function() {
        if (document.getElementById('payment-element')) {
            setTimeout(initializeStripe, 100);
        }
    });
</script>