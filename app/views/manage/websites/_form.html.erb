<!-- app/views/manage/websites/_form.html.erb -->
<%= form_with model: @website, url: { controller: 'manage/websites', action: 'create', class: 'max-w-2xl mx-auto' }, local: true do |form| %>
  <% if website.errors.any? %>
    <div id="error_explanation" class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
      <h4 class="text-red-800 font-semibold mb-2">
        <%= pluralize(website.errors.count, "error") %> prohibited this website from being saved:
      </h4>
      <ul class="text-red-700 space-y-1">
        <% website.errors.full_messages.each do |message| %>
          <li class="flex items-start">
            <span class="inline-block w-1 h-1 bg-red-400 rounded-full mt-2 mr-2 flex-shrink-0"></span>
            <%= message %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :user_id, value: current_user.id %>

  <!-- Step 1: Website Name -->
  <div id="step-1" class="step-content">
    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Let's start with your website name</h2>
      <p class="text-gray-600">Choose a memorable name for your new website</p>
    </div>

    <div class="mb-8">
      <%= form.label :name, class: 'block text-sm font-medium text-gray-700 mb-2' %>
      <%= form.text_field :name,
                          class: 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors',
                          placeholder: 'Enter your website name...' %>
    </div>

    <div class="flex justify-between items-center">
      <div class="flex space-x-2">
        <div class="w-8 h-2 bg-blue-500 rounded-full"></div>
        <div class="w-8 h-2 bg-gray-200 rounded-full"></div>
      </div>
      <button type="button" id="next-step" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors font-medium">
        Next Step
      </button>
    </div>
  </div>

  <!-- Step 2: Theme Selection -->
  <div id="step-2" class="step-content hidden">
    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Choose your theme</h2>
      <p class="text-gray-600">Select a theme that matches your style</p>
    </div>

    <div class="mb-8">
      <fieldset>
        <legend class="block text-sm font-medium text-gray-700 mb-4">Available Themes</legend>
        <div class="space-y-3">
          <% @themes.each do |theme| %>
            <label class="relative flex items-center p-4 border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50 focus-within:ring-2 focus-within:ring-blue-500 transition-colors">
              <%= form.radio_button :theme_id,
                                    theme.id,
                                    class: 'sr-only peer',
                                    checked: website.theme_id == theme.id %>
              <div class="flex items-center w-full">
                <div class="w-4 h-4 border-2 border-gray-300 rounded-full peer-checked:border-blue-600 peer-checked:bg-blue-600 relative flex-shrink-0">
                  <div class="w-2 h-2 bg-white rounded-full absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 opacity-0 peer-checked:opacity-100"></div>
                </div>
                <div class="ml-4 flex-1">
                  <div class="font-medium text-gray-900"><%= theme.name %></div>
                  <% if theme.respond_to?(:description) && theme.description.present? %>
                    <div class="text-sm text-gray-500"><%= theme.description %></div>
                  <% end %>
                </div>
              </div>
            </label>
          <% end %>
        </div>
      </fieldset>
    </div>

    <div class="flex justify-between items-center">
      <button type="button" id="prev-step" class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-colors font-medium">
        Previous
      </button>
      <div class="flex space-x-2">
        <div class="w-8 h-2 bg-blue-500 rounded-full"></div>
        <div class="w-8 h-2 bg-blue-500 rounded-full"></div>
      </div>
      <div class="flex space-x-3">
        <%= link_to 'Cancel', manage_dashboard_path, class: 'px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-colors font-medium' %>
        <%= form.submit 'Create Website', class: 'px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-colors font-medium' %>
      </div>
    </div>
  </div>

  <script>
      function initializeStepForm() {
          const step1 = document.getElementById('step-1');
          const step2 = document.getElementById('step-2');
          const nextBtn = document.getElementById('next-step');
          const prevBtn = document.getElementById('prev-step');
          const nameField = document.querySelector('input[name="website[name]"]');

          if (!step1 || !step2 || !nextBtn || !prevBtn || !nameField) {
              console.log('Form elements not found, retrying...');
              setTimeout(initializeStepForm, 100);
              return;
          }

          // Remove any existing event listeners
          nextBtn.replaceWith(nextBtn.cloneNode(true));
          prevBtn.replaceWith(prevBtn.cloneNode(true));

          // Get fresh references after cloning
          const newNextBtn = document.getElementById('next-step');
          const newPrevBtn = document.getElementById('prev-step');

          newNextBtn.addEventListener('click', function(e) {
              e.preventDefault();
              if (nameField.value.trim() === '') {
                  nameField.focus();
                  nameField.classList.add('border-red-500', 'focus:ring-red-500', 'focus:border-red-500');
                  return;
              }

              nameField.classList.remove('border-red-500', 'focus:ring-red-500', 'focus:border-red-500');
              step1.classList.add('hidden');
              step2.classList.remove('hidden');
          });

          newPrevBtn.addEventListener('click', function(e) {
              e.preventDefault();
              step2.classList.add('hidden');
              step1.classList.remove('hidden');
          });

          // Remove error styling when user starts typing
          nameField.addEventListener('input', function() {
              this.classList.remove('border-red-500', 'focus:ring-red-500', 'focus:border-red-500');
          });
      }

      // Handle both regular page loads and Turbo navigation
      document.addEventListener('DOMContentLoaded', initializeStepForm);
      document.addEventListener('turbo:load', initializeStepForm);

      // Fallback for immediate execution
      if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initializeStepForm);
      } else {
          initializeStepForm();
      }
  </script>
<% end %>