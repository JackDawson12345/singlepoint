<%= form_with(model: @theme, url: (@theme.persisted? ? "/admin/themes/#{@theme.id}" : "/admin/themes"), method: (@theme.persisted? ? :patch : :post), local: true, class: "mx-auto") do |form| %>
  <% if @theme.errors.any? %>
    <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-md">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(@theme.errors.count, "error") %> prohibited this theme from being saved:
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% @theme.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", placeholder: "Enter theme name" %>
    </div>

    <div>
      <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :description, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", rows: 4, placeholder: "Describe this theme and its intended use..." %>
    </div>

    <div>
      <%= form.label :image_url, "Theme Image URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.url_field :image_url, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", placeholder: "https://example.com/theme-preview.jpg" %>
    </div>

    <!-- Image Preview -->
    <% if @theme.image_url.present? %>
      <div class="mt-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">Current Image Preview</label>
        <div class="theme-image-preview">
          <%= image_tag @theme.image_url,
                        alt: @theme.name,
                        class: "w-full h-48 object-cover rounded-md border border-gray-200",
                        onerror: "this.style.display='none'; this.nextElementSibling.style.display='block';" %>
          <div class="hidden bg-gray-50 border border-gray-200 rounded-md p-6 text-center">
            <svg class="mx-auto h-8 w-8 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L4.232 15.5c-.77.833.192 2.5 1.732 2.5z"></path>
            </svg>
            <p class="text-sm text-gray-500">Unable to load image from the provided URL</p>
          </div>
        </div>
      </div>
    <% end %>

    <div class="pt-4">
      <%= form.submit class: "w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition duration-200 font-medium" %>
    </div>
  </div>
<% end %>

<script>
    // Live image preview
    document.addEventListener('DOMContentLoaded', function() {
        const imageUrlInput = document.getElementById('theme_image_url');

        if (imageUrlInput) {
            let timeoutId;

            imageUrlInput.addEventListener('input', function() {
                clearTimeout(timeoutId);

                // Debounce the preview update
                timeoutId = setTimeout(() => {
                    updateImagePreview(this.value);
                }, 500);
            });
        }

        function updateImagePreview(url) {
            let previewContainer = document.querySelector('.theme-image-preview');

            if (!previewContainer && url.trim()) {
                // Create preview container if it doesn't exist
                const previewHTML = `
          <div class="mt-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Image Preview</label>
            <div class="theme-image-preview"></div>
          </div>
        `;

                const imageUrlDiv = imageUrlInput.closest('div');
                imageUrlDiv.insertAdjacentHTML('afterend', previewHTML);
                previewContainer = document.querySelector('.theme-image-preview');
            }

            if (previewContainer) {
                if (url.trim()) {
                    previewContainer.innerHTML = `
            <img src="${url}"
                 alt="Theme preview"
                 class="w-full h-48 object-cover rounded-md border border-gray-200"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
            <div class="hidden bg-gray-50 border border-gray-200 rounded-md p-6 text-center">
              <svg class="mx-auto h-8 w-8 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L4.232 15.5c-.77.833.192 2.5 1.732 2.5z"></path>
              </svg>
              <p class="text-sm text-gray-500">Unable to load image from the provided URL</p>
            </div>
          `;
                } else {
                    previewContainer.innerHTML = '';
                }
            }
        }
    });
</script>