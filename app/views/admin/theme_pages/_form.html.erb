<%= form_with(model: @theme_page,
              url: (@theme_page.persisted? ?
                      "/admin/theme-pages/#{@theme_page.id}" :
                      admin_theme_pages_path),
              method: (@theme_page.persisted? ? :patch : :post),
              local: true,
              class: "mx-auto") do |form| %>
  <% if @theme_page.errors.any? %>
    <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-md">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(@theme_page.errors.count, "error") %> prohibited this theme page from being saved:
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% @theme_page.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%= form.hidden_field :theme_id, value: params[:id] %>

  <div class="space-y-4">
    <div>
      <%= form.label :page_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :page_type,
                      options_for_select([
                                           ['Home', 'Home'],
                                           ['About Us', 'About Us'],
                                           ['Services', 'Services'],
                                           ['Testimonials', 'Testimonials'],
                                           ['FAQs', 'FAQs'],
                                           ['Contact Us', 'Contact Us']
                                         ], @theme_page.page_type),
                      { prompt: 'Select a page type' },
                      { class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
    </div>

    <div>
      <%= form.label :component_order, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :component_order,
                         rows: 4,
                         placeholder: 'JSON or comma-separated list of component order',
                         class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= form.label :package, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :package,
                      options_for_select([
                                           ['Bespoke', 'bespoke'],
                                           ['E-commerce', 'e-commerce']
                                         ], @theme_page.package),
                      { prompt: 'Select a package type' },
                      { class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
    </div>

    <div class="pt-4">
      <%= form.submit class: "w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition duration-200 font-medium" %>
    </div>
  </div>
<% end %>