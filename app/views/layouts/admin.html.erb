00002 -1.7500000000000002 -1.7500000000000002h-2.1c-0.966875 0 -1.7500000000000002 0.7831250000000001 -1.7500000000000002 1.7500000000000002v2.1c0 0.966875 0.7831250000000001 1.7500000000000002 1.7500000000000002 1.7500000000000002h2.1c0.966875 0 1.7500000000000002 -0.7831250000000001 1.7500000000000002 -1.7500000000000002v-2.1Z" fill="#6B7280" stroke-width="0.0446"></path>
        </svg>
      </div>
      <div class="flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" id="Moon--Streamline-Font-Awesome" height="20" width="20">
          <path d="M11.374963541666668 0.2c-5.403125 0 -9.778125000000001 4.388125 -9.778125000000001 9.8s4.375 9.8 9.778125000000001 9.8c2.65125 0 5.053125 -1.05875 6.816250000000001 -2.77375 0.21875000000000003 -0.21437499999999998 0.275625 -0.546875 0.13562500000000002 -0.818125s-0.441875 -0.424375 -0.74375 -0.371875c-0.42874999999999996 0.074375 -0.8662500000000001 0.11375000000000002 -1.316875 0.11375000000000002 -4.239375 0 -7.678125 -3.4475 -7.678125 -7.7 0 -2.87875 1.575 -5.385625 3.9068750000000003 -6.706875 0.266875 -0.153125 0.4025 -0.45937500000000003 0.33687500000000004 -0.7568750000000001s-0.319375 -0.520625 -0.6256250000000001 -0.546875c-0.275625 -0.021875 -0.55125 -0.035 -0.83125 -0.035Z" fill="#6B7280" stroke-width="0.0521"></path>
        </svg>
      </div>
      <div class="flex items-center">
        <hr style="width: 1px; height: 20px; background: #e5e7eb;">
      </div>
      <div class="flex items-center">
        <%= image_tag 'Portrait_Placeholder.png', style: 'width: 32px; height: 32px; border-radius: 100px;'%>
      </div>
    </div>

  </div>
  <%= link_to "Log out", destroy_user_session_path, class: 'ml-3 text-red-600 hover:text-red-800 bg-transparent border-0 p-0 cursor-pointer', data: { "turbo-method": :delete } %>
</header>

<!-- Layout -->
<div class="flex h-[calc(100vh-4rem)]">

  <!-- Sidebar -->
  <aside
    class="bg-white border-r transition-all duration-300 overflow-hidden"
    :class="{ 'w-64': sidebarOpen, 'w-18': !sidebarOpen }"
    @mouseenter="handleMouseEnter()"
    @mouseleave="handleMouseLeave()"
  >
    <nav class="flex flex-col gap-2 p-4 text-sm" x-data="{ openUsers: false, openWebsites: false, openProducts: false, openComponents: false, openSettings: false, openReports: false, openThemes: false, openHelp: false}">

      <!-- Dashboard -->
      <button class="w-full flex items-center justify-between text-gray-700 hover:bg-gray-100 py-3 px-2 rounded">
        <div class="flex items-center gap-3">
          <!-- Star icon -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" id="Chart-Pie--Streamline-Font-Awesome" height="20" width="20">
            <path d="M10.037444444444445 9.42132638888889V1.3416041666666667c0 -0.3255034722222222 0.25316666666666665 -0.6003750000000001 0.578670138888889 -0.6003750000000001 4.473868055555555 0 8.10142361111111 3.6275590277777776 8.10142361111111 8.10142361111111 0 0.3255034722222222 -0.27486805555555555 0.5786736111111112 -0.6003715277777778 0.5786736111111112h-8.079722222222223ZM0.2 10.57867361111111c0 -4.3870659722222225 3.258652777777778 -8.018239583333333 7.486583333333333 -8.596913194444445 0.3327361111111111 -0.047017361111111114 0.6148402777777778 0.22061805555555555 0.6148402777777778 0.5569722222222223v8.618614583333335l5.660145833333334 5.660145833333334c0.24231944444444445 0.24231944444444445 0.22423611111111114 0.64015625 -0.05425 0.8354583333333333 -1.41775 1.0126770833333334 -3.1537673611111114 1.6058194444444445 -5.027222222222222 1.6058194444444445C4.087958333333334 19.258770833333333 0.2 15.374427083333334 0.2 10.57867361111111Zm19.038343750000003 0.5786736111111112c0.3363541666666667 0 0.6003750000000001 0.2821006944444444 0.5569756944444445 0.6148402777777778 -0.27848611111111116 2.0217395833333334 -1.2513819444444445 3.819243055555556 -2.672746527777778 5.146572916666667 -0.21700347222222222 0.20253472222222224 -0.5569756944444445 0.18806944444444446 -0.7667430555555556 -0.025315972222222222L10.616114583333333 11.157347222222223h8.622232638888889Z" fill="#9ca3af" stroke-width="0.0347"></path>
          </svg>
          <span x-show="sidebarOpen" x-transition.opacity><%= link_to 'Dashboard', admin_dashboard_path %></span>


        </div>

      </button>
      <!-- Users -->
      <div>
        <button @click="openUsers = !openUsers" class="w-full flex items-center justify-between text-gray-700 hover:bg-gray-100 py-3 px-2 rounded">
          <div class="flex items-center gap-3">
            <!-- User icon -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" id="User--Streamline-Font-Awesome" height="20" width="20">
              <path d="M10 10c3.7720223214285715 0 6.129535714285715 -4.083334821428572 4.243522321428571 -7.35C13.368223214285713 1.1339330357142856 11.750602678571429 0.2 10 0.2c-3.7720223214285715 0 -6.129535714285715 4.083334821428572 -4.243522321428571 7.35C6.631776785714285 9.066066964285715 8.249397321428571 10 10 10Zm-1.7494508928571428 1.8375c-3.7707053571428575 0 -6.825549107142858 3.05484375 -6.825549107142858 6.825549107142858 0 0.6278125 0.5091383928571429 1.136950892857143 1.136950892857143 1.136950892857143h14.876098214285715c0.6278125 0 1.136950892857143 -0.5091383928571429 1.136950892857143 -1.136950892857143 0 -3.7707053571428575 -3.05484375 -6.825549107142858 -6.825544642857143 -6.825549107142858h-3.49890625Z" fill="#9ca3af" stroke-width="0.0446"></path>
            </svg>
            <span x-show="sidebarOpen" x-transition.opacity>Users</span>
          </div>
          <div x-show="sidebarOpen" :class="{ 'rotate-180': openUsers }" class="transition-transform duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="12" height="12">
              <path d="M18.023 30.378c1.093 1.093 2.869 1.093 3.962 0l16.794-16.794c1.093-1.093 1.093-2.869 0-3.962s-2.869-1.093-3.962 0L20 24.439 5.182 9.63c-1.093-1.093-2.869-1.093-3.962 0s-1.093 2.869 0 3.962l16.794 16.794z" fill="#9ca3af"/>
            </svg>
          </div>
        </button>
        <div x-show="openUsers && sidebarOpen" class="mt-1">
          <%= link_to 'View All Users', admin_users_path, class: 'block text-gray-700 hover:bg-gray-100 py-3 px-2 rounded' %>
          <%= link_to 'Add New User', admin_users_new_path, class: 'block text-gray-700 hover:bg-gray-100 py-3 px-2 roundedblack' %>
        </div>
      </div>
      <!-- Websites -->
      <div>
        <button @click="openWebsites = !openWebsites" class="w-full flex items-center justify-between text-gray-700 hover:bg-gray-100 py-3 px-2 rounded">
          <div class="flex items-center gap-3">
            <!-- Star icon -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" id="Globe--Streamline-Font-Awesome" height="20" width="20">
              <path d="M13.75 10c0 0.8671875 -0.046875 1.703125 -0.12890625 2.5H6.37890625c-0.0859375 -0.796875 -0.12890625 -1.6328125 -0.12890625 -2.5s0.046875 -1.703125 0.12890625 -2.5h7.2421875c0.0859375 0.796875 0.12890625 1.6328125 0.12890625 2.5zm1.125 -2.5h4.80859375c0.20703125 0.80078125 0.31640625 1.63671875 0.31640625 2.5s-0.109375 1.69921875 -0.31640625 2.5H14.875c0.08203125 -0.8046875 0.125 -1.640625 0.125 -2.5s-0.04296875 -1.6953125 -0.125 -2.5zm4.3984375 -1.25H14.71484375c-0.390625 -2.49609375 -1.1640625 -4.5859375 -2.16015625 -5.921875 3.05859375 0.80859375 5.546875 3.02734375 6.71484375 5.921875zm-5.82421875 0H6.55078125c0.23828125 -1.421875 0.60546875 -2.6796875 1.0546875 -3.69921875 0.41015625 -0.921875 0.8671875 -1.58984375 1.30859375 -2.01171875C9.3515625 0.125 9.71484375 0 10 0s0.6484375 0.125 1.0859375 0.5390625c0.44140625 0.421875 0.8984375 1.08984375 1.30859375 2.01171875 0.453125 1.015625 0.81640625 2.2734375 1.0546875 3.69921875zm-8.1640625 0H0.7265625c1.171875 -2.89453125 3.65625 -5.11328125 6.71875 -5.921875 -0.99609375 1.3359375 -1.76953125 3.42578125 -2.16015625 5.921875zM0.31640625 7.5h4.80859375c-0.08203125 0.8046875 -0.125 1.640625 -0.125 2.5s0.04296875 1.6953125 0.125 2.5H0.31640625C0.109375 11.69921875 0 10.86328125 0 10s0.109375 -1.69921875 0.31640625 -2.5zm7.2890625 9.9453125c-0.453125 -1.015625 -0.81640625 -2.2734375 -1.0546875 -3.6953125h6.8984375c-0.23828125 1.421875 -0.60546875 2.6796875 -1.0546875 3.6953125 -0.41015625 0.921875 -0.8671875 1.58984375 -1.30859375 2.01171875 -0.4375 0.41796875 -0.80078125 0.54296875 -1.0859375 0.54296875s-0.6484375 -0.125 -1.0859375 -0.5390625c-0.44140625 -0.421875 -0.8984375 -1.08984375 -1.30859375 -2.01171875zM5.28515625 13.75c0.390625 2.49609375 1.1640625 4.5859375 2.16015625 5.921875 -3.0625 -0.80859375 -5.546875 -3.02734375 -6.71875 -5.921875h4.55859375zm13.98828125 0c-1.171875 2.89453125 -3.65625 5.11328125 -6.71484375 5.921875 0.99609375 -1.3359375 1.765625 -3.42578125 2.16015625 -5.921875h4.5546875z" fill="#9ca3af" stroke-width="0.0391"></path>
            </svg>
            <span x-show="sidebarOpen" x-transition.opacity>Websites</span>
          </div>
          <div x-show="sidebarOpen" :class="{ 'rotate-180': openWebsites }" class="transition-transform duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="12" height="12">
              <path d="M18.023 30.378c1.093 1.093 2.869 1.093 3.962 0l16.794-16.794c1.093-1.093 1.093-2.869 0-3.962s-2.869-1.093-3.962 0L20 24.439 5.182 9.63c-1.093-1.093-2.869-1.093-3.962 0s-1.093 2.869 0 3.962l16.794 16.794z" fill="#9ca3af"/>
            </svg>
          </div>
        </button>
        <div x-show="openWebsites && sidebarOpen" class="mt-1">
          <%= link_to 'View All Websites', admin_dashboard_path, class: 'block text-gray-700 hover:bg-gray-100 py-3 px-2 rounded' %>
          <%= link_to 'Create A New Website', admin_dashboard_path, class: 'block text-gray-700 hover:bg-gray-100 py-3 px-2 roundedblack' %>
        </div>
      </div>
      <!-- Products -->
      <div>
        <button @click="openProducts = !openProducts" class="w-full flex items-center justify-between text-gray-700 hover:bg-gray-100 py-3 px-2 rounded">
          <div class="flex items-center gap-3">
